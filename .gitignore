__pycache__/
*.py[cod]
*$py.class
*.so
.env
.DS_Store
Thumbs.db

# Virtual Environment
venv/
env/
ENV/

# Dev
docs/agent instructions/Pre-build_check.md

# Distribution / packaging
build/
dist/
*.spec
# ...except the build's own specs: package_app.py --release needs both
!packaging/*.spec

# User Files
User Files/
data/
results/
debug/app_debug_log.txt
debug/build_log.txt
surasura_v*.zip

# Pytest
.pytest_cache/
# Test-run artifacts (SURASURA_TEST_PROFILE output + captured run logs) live under debug/,
# never in the repo root.
debug/testlog.txt
debug/testprofile*.csv
# Anki collection snapshots and run settings taken while developing the junban module
# (dev artifacts; they hold the developer's own deck and note contents)
debug/anki_*.json
debug/wpk_*.json
# Your own settings.json, parked while the clean shipped one is committed (it names your decks).
debug/settings.personal*.json

# Auto-update runtime artifacts (created next to the exe at runtime)
.update_staging/
.update_backup/
pending_update.json
last_update_result.json
updater.exe


docs/agent instructions
docs/pre release notes

# Modules
modules/*
launch_immersion_architect.py
CLAUDE.md

# Legacy code reviews (local only)
docs/legacy_code_reviews/

# Third-party integration research (local only — contains account identifiers)
docs/research/

# Reference corpora — build inputs for scripts/build_reference_data.py only.
# Large, third-party, and never shipped: the build script distils them into the
# committed app/reference_data.py, which is what the app actually reads.
docs/assets/reference_lists/

# OpenCC dictionaries (Apache-2.0) — build inputs for scripts/build_zh_script_data.py only,
# distilled into the committed app/zh_script_data.py.
docs/assets/opencc/

# NLT gold set for the junban Patterns quality gate — exported by hand from NINJAL-LWP for TWC,
# whose terms are research/educational: never published. The review page compares against it.
docs/assets/nlt_gold/
debug/patterns_review*.html

# General Japanese corpora for the Patterns databases and the corpus assets (Patterns_Spec.md
# WP-P10) — third-party downloads under their own licences (CC BY-SA, CC BY-NC, NC-ND, …) and the
# text and dictionaries built from them. Large, never shipped, never published.
docs/assets/corpora/

# Chinese gold set for the junban Patterns quality gate (Patterns_Chinese_Spec.md §11) — CC-CEDICT, the UD
# Chinese treebanks, Wiktionary's separable verbs (all CC BY-SA 4.0), downloaded for local checks only.
docs/assets/zh_gold/
debug/patterns_review_zh*.html

# Visual checks — screenshots a spec's done-condition asks for (e.g. Junban_Backlog_Spec WP-B8).
debug/*.png
